{
  "name":"re8ch-flux-static",
  "main":"index.mjs",
  "compatibility_date":"2026-10-25",
  "workers_dev":true,
  "routes":[{"pattern":"flux-status.re8ch.com","custom_domain":true}],
  "assets":{"directory":"../web-public","binding":"ASSETS","run_worker_first":["/latest.json","/api/*"]},
  "r2_buckets":[{"binding":"SNAPSHOTS","bucket_name":"re8ch-flux-public-status"}],
  "vars":{"SOURCE_REPOSITORY":"re8ch/service-backend","SOURCE_REPOSITORY_ID":"1367237854","SOURCE_OWNER_ID":"283958313","PUBLISH_AUDIENCE":"https://flux-status.re8ch.com/api/snapshot"}
}
